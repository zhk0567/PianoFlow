<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E13"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="曲库"
        android:textColor="#F5F2EB"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="12dp"
        android:paddingTop="4dp"
        android:text="按谱种、难度或风格挑一张，直接开练"
        android:textColor="#9AA3B2"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/libSearch"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_search_field"
        android:hint="搜索曲名、作曲家、风格或谱种"
        android:paddingHorizontal="14dp"
        android:textColor="#F5F2EB"
        android:textColorHint="#6E7686"
        android:inputType="text" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/libFilters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/libCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:textColor="#6E7686"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/libOmrHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="6dp"
        android:text="OMR 草稿未逐音校对，勿当教材级正式谱。"
        android:textColor="#E8A849"
        android:textSize="13sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/songList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
