<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PianoFlow" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#E8A849</item>
        <item name="colorSecondary">#E8A849</item>
        <item name="android:statusBarColor">#0B0E13</item>
        <item name="android:navigationBarColor">#141920</item>
        <item name="android:windowBackground">#0B0E13</item>
    </style>

    <style name="Theme.PianoFlow.Immersive" parent="Theme.PianoFlow">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="PfChip" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">#F5F2EB</item>
        <item name="backgroundTint">#1A212C</item>
    </style>

    <style name="PfChip.Active" parent="PfChip">
        <item name="backgroundTint">#3D2E14</item>
        <item name="android:textColor">#FFD078</item>
    </style>
</resources>
