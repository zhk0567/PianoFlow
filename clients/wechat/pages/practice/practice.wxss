.page {
  padding: 16px;
  background: #0f1419;
  min-height: 100vh;
  color: #e8eef5;
  box-sizing: border-box;
}
.banner {
  background: #1a2838;
  border: 1px solid #2a4a6a;
  color: #9ec5e8;
  padding: 10px 12px;
  border-radius: 8px;
  font-size: 12px;
  line-height: 1.45;
  margin-bottom: 14px;
}
.title {
  font-size: 22px;
  font-weight: 700;
}
.meta {
  color: #8a96a8;
  margin: 4px 0 14px;
  font-size: 13px;
}
.staff-card {
  background: #151b22;
  border: 1px solid #2a3340;
  border-radius: 10px;
  padding: 12px;
  margin-bottom: 16px;
}
.staff-label {
  font-size: 13px;
  color: #a8b4c4;
  margin-bottom: 8px;
}
.staff-scroll {
  width: 100%;
  height: 180px;
  background: #0c1016;
  border-radius: 8px;
}
.staff-canvas {
  position: relative;
  height: 176px;
}
.line {
  position: absolute;
  left: 0;
  right: 0;
  height: 1px;
  background: #4a5568;
}
.note {
  position: absolute;
  height: 22px;
  line-height: 22px;
  text-align: center;
  font-size: 10px;
  color: #0b1220;
  background: #7dd3fc;
  border-radius: 11px;
  transform: translateY(-11px);
  box-sizing: border-box;
  padding: 0 2px;
  overflow: hidden;
}
.preview {
  margin-top: 10px;
  font-size: 12px;
  color: #c5d0dc;
  word-break: break-all;
}
.hint {
  margin-top: 8px;
  font-size: 12px;
  color: #8a96a8;
  line-height: 1.4;
}
.metro {
  background: #151b22;
  border: 1px solid #2a3340;
  border-radius: 10px;
  padding: 14px;
  transition: background 0.08s;
}
.metro.flash {
  background: #243044;
  border-color: #4a7ab0;
}
.metro-title {
  font-size: 16px;
  font-weight: 600;
  margin-bottom: 10px;
}
.row {
  display: flex;
  gap: 8px;
  align-items: center;
  flex-wrap: wrap;
}
