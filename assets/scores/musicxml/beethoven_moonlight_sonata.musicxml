    <measure number="28" width="462">
      <print new-system="yes">
        <system-layout>
          <system-margins>
            <left-margin>93</left-margin>
            <right-margin>99</right-margin>
          </system-margins>
          <system-distance>100</system-distance>
        </system-layout>
        <staff-layout number="2">
          <staff-distance>67</staff-distance>
        </staff-layout>
      </print>
      <attributes>
        <staff-details print-object="yes" />
      </attributes>
      <direction placement="below">
