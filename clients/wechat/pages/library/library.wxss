.page { padding: 24rpx; background: #0f1419; min-height: 100vh; }
.banner {
  color: #5ad4a0;
  font-size: 26rpx;
  margin-bottom: 24rpx;
  padding: 16rpx;
  background: rgba(90, 212, 160, 0.12);
  border-radius: 12rpx;
}
.card {
  background: rgba(255, 255, 255, 0.06);
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.title { display: block; color: #e8eef4; font-size: 34rpx; font-weight: 600; }
.meta { display: block; color: #9aa7b5; font-size: 24rpx; margin-top: 8rpx; }
.honesty { display: block; color: #7eb8e8; font-size: 22rpx; margin-top: 12rpx; line-height: 1.4; }
