    <measure number="16" width="458">
      <print new-page="yes">
        <system-layout>
          <system-margins>
            <left-margin>93</left-margin>
            <right-margin>99</right-margin>
          </system-margins>
          <top-system-distance>282</top-system-distance>
        </system-layout>
        <staff-layout number="2">
          <staff-distance>94</staff-distance>
        </staff-layout>
        <measure-numbering>system</measure-numbering>
      </print>
      <attributes>
        <divisions>12</divisions>
        <key>
          <fifths>4</fifths>
        </key>
        <staff-details print-object="yes" />
      </attributes>
      <direction placement="below">
        <direction-type>
          <wedge type="crescendo" spread="0" default-x="-1" default-y="-82" />
        </direction-type>
        <staff>2</staff>
      </direction>
      <direction>
        <direction-type>
          <wedge type="stop" spread="18" default-x="-4" />
        </direction-type>
        <staff>2</staff>
      </direction>
      <direction placement="below">
        <direction-type>
          <dynamics default-y="-84" relative-x="-2">
            <p />
          </dynamics>
        </direction-type>
        <staff>2</staff>
        <sound dynamics="56" />
