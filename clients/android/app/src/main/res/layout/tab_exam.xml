<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E13"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="考试"
        android:textColor="#F5F2EB"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="12dp"
        android:paddingTop="4dp"
        android:text="选曲开考：跟弹计分，本地结算"
        android:textColor="#9AA3B2"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/examSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="#141920"
        android:hint="搜索曲目"
        android:inputType="text"
        android:padding="12dp"
        android:textColor="#F5F2EB"
        android:textColorHint="#6E7686" />

    <TextView
        android:id="@+id/examHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="4dp"
        android:text="暂无考试记录"
        android:textColor="#6E7686"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/examHistoryDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:textColor="#9AA3B2"
        android:textSize="12sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/examList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <CheckBox
        android:id="@+id/examRecord"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="计入本地战绩"
        android:textColor="#9AA3B2" />

    <CheckBox
        android:id="@+id/examRecordAudio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checked="false"
        android:text="录制本场 PCM 回放"
        android:textColor="#9AA3B2" />

    <Button
        android:id="@+id/examStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#E8A849"
        android:enabled="false"
        android:text="开始考试"
        android:textColor="#000000" />
</LinearLayout>
