<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E13"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="24dp"
            android:text="PianoFlow"
            android:textColor="#F5F2EB"
            android:textSize="42sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="20dp"
            android:text="跟弹练习 · 与 Windows 同结构"
            android:textColor="#9AA3B2"
            android:textSize="15sp" />

        <Button
            android:id="@+id/homeCta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#E8A849"
            android:text="去曲库看看"
            android:textColor="#000000" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="28dp"
            android:paddingBottom="8dp"
            android:text="最近练习"
            android:textColor="#F5F2EB"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/homeRecent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_home_card"
            android:padding="16dp"
            android:text="暂无 · 去曲库开练"
            android:textColor="#9AA3B2" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="20dp"
            android:paddingBottom="8dp"
            android:text="我的收藏"
            android:textColor="#F5F2EB"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/homeFavorites"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_home_card"
            android:padding="16dp"
            android:text="暂无 · 曲库点星标收藏"
            android:textColor="#9AA3B2" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="20dp"
            android:paddingBottom="8dp"
            android:text="今日推荐"
            android:textColor="#F5F2EB"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/homeToday"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_home_card"
            android:padding="16dp"
            android:textColor="#F5F2EB" />
    </LinearLayout>
</ScrollView>
