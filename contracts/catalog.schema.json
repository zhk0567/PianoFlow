{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pianoflow.local/contracts/catalog.schema.json",
  "title": "PianoFlowCatalog",
  "type": "object",
  "required": ["songs"],
  "properties": {
    "songs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/song" }
    }
  },
  "$defs": {
    "scoreKind": {
      "type": "string",
      "enum": ["formal", "simplified", "omrDraft", "userImport"],
      "description": "formal=已校对/教材级；omrDraft=OMR未校对；simplified=简化谱；userImport=用户导入（永不可标 formal）"
    },
    "song": {
      "type": "object",
      "required": ["id", "title", "scoreKind", "musicXml"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "artist": { "type": "string" },
        "genre": { "type": "string" },
        "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
        "bpm": { "type": "number", "exclusiveMinimum": 0 },
        "durationHint": { "type": "number" },
        "description": { "type": "string" },
        "scoreKind": { "$ref": "#/$defs/scoreKind" },
        "musicXml": {
          "type": "string",
          "description": "相对 contracts/ 或客户端约定根的 MusicXML 路径"
        },
        "asset": {
          "type": "string",
          "description": "可选：Flutter 端 JSON 练习资产（Windows 沿用）"
        }
      }
    }
  }
}
